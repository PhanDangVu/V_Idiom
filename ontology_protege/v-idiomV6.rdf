  <rdfs:domain rdf:resource="#Khung_Bản_Thể_học"/>
  <rdfs:range rdf:resource="#Kết_quả"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#Có_mục_đích">
  <rdfs:domain rdf:resource="#Khung_Bản_Thể_học"/>
  <rdfs:range rdf:resource="#Mục_đích"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#Là_khung_của">
  <rdfs:domain rdf:resource="#Khung_Bản_Thể_học"/>
  <rdfs:range rdf:resource="#Thành_ngữ_Tục_ngữ"/>
  <owl:inverseOf rdf:resource="#Có_khung"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#Có_khung">
  <rdfs:domain rdf:resource="#Thành_ngữ_Tục_ngữ"/>
  <rdfs:range rdf:resource="#Khung_Bản_Thể_học"/>
  <owl:inverseOf rdf:resource="#Là_khung_của"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#Có_nghĩa">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#Có_khung"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#Là_khung_của"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:domain rdf:resource="#Thành_ngữ_Tục_ngữ"/>
  <rdfs:range rdf:resource="#Thành_ngữ_Tục_ngữ"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Thành_ngữ_Tục_ngữ">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Vietnamese_idiom">
  <rdfs:subClassOf rdf:resource="#Thành_ngữ_Tục_ngữ"/>
</owl:Class>

<owl:Class rdf:about="#English_Idiom">
  <rdfs:subClassOf rdf:resource="#Thành_ngữ_Tục_ngữ"/>
</owl:Class>

<owl:Class rdf:about="#Tiêu_chí">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Bối_cảnh">
  <rdfs:subClassOf rdf:resource="#Tiêu_chí"/>
</owl:Class>

<owl:Class rdf:about="#Hành_động">
  <rdfs:subClassOf rdf:resource="#Tiêu_chí"/>
</owl:Class>

<owl:Class rdf:about="#Kết_quả">
  <rdfs:subClassOf rdf:resource="#Tiêu_chí"/>
</owl:Class>

<owl:Class rdf:about="#Mục_đích">
  <rdfs:subClassOf rdf:resource="#Tiêu_chí"/>
</owl:Class>

<owl:Class rdf:about="#Khung_Bản_Thể_học">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#HD_Bàn_tán">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhiều người trao đổi, đồn đoán hoặc bình luận về người hay việc khác; không tự khẳng định nội dung bàn tán đúng hay sai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bày_mưu">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sắp đặt một kế hoạch có tính toán nhằm tác động đến người khác; mục tiêu hại người được xác định riêng bằng MD khi có căn cứ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bỏ_nhỏ_cầu_lớn">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bỏ ra hoặc chấp nhận rủi ro mất một thứ ít giá trị để có cơ hội nhận thứ có giá trị lớn hơn. Chưa khẳng định đã thu lợi lớn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bỏ_rơi">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rút lại hoặc từ chối sự quan tâm, giúp đỡ hay hỗ trợ trong một quan hệ. Không nhất thiết có âm mưu gây hại.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bộc_lộ_bản_chất">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thể hiện ra đặc điểm thật hoặc ý đồ từng bị che giấu; có thể là vô tình lộ ra chứ không phải cố ý công khai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bộc_lộ_cảm_xúc">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Để người khác dễ nhận thấy tình cảm qua lời nói, nét mặt hoặc hành vi, thay vì giấu trong lòng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bội_bạc">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rút bỏ sự biết ơn, trung thành hoặc hỗ trợ, hay quay lại đối xử xấu với người từng có quan hệ gắn bó hoặc giúp đỡ mình.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bù_chỗ_thiếu">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chuyển tiền hoặc nguồn lực từ nhu cầu này sang nhu cầu khác để tạm lấp thiếu hụt, có thể tạo ra thiếu hụt ở nơi bị lấy đi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Bùng_giận">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phản ứng giận dữ xuất hiện đột ngột và mạnh, có thể thể hiện bằng lời nói hoặc hành vi; khác với chỉ đang cảm thấy giận.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cai_quản_cứng_rắn">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều hành và áp đặt kỷ luật bằng cách nghiêm khắc, ít chấp nhận sự không tuân theo.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cãi_vã">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trao đổi lời nói mang tính đối chọi hoặc gay gắt giữa các bên; không đồng nhất với bất đồng được trình bày ôn hòa.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cắt_chi_tiêu">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giảm các khoản tiền dùng cho sinh hoạt hoặc nhu cầu khác để giữ lại nguồn lực.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cắt_đứt">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chấm dứt việc gắn bó hoặc tiếp tục tham gia một quan hệ hay sự việc, theo nghĩa đã chọn ở từng dòng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cắt_giao_tiếp">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ngừng nói chuyện hoặc tiếp xúc với người khác do quan hệ bị tổn hại; không tự khẳng định mọi liên hệ đều chấm dứt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chạy_nhanh">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Di chuyển bằng cách chạy với tốc độ cao. Không tự thêm mục đích chạy trốn hoặc bắt đuổi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chặn_cơ_hội">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm người khác không thể tiếp cận con đường hoặc điều kiện tạo lợi ích mà chủ thể đã sử dụng hoặc đang nắm giữ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chi_lãng_phí">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sử dụng tiền quá mức hoặc vào việc không đem lại giá trị tương xứng; không đồng nhất với mọi khoản chi lớn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chi_phung_phí">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiêu tiền rất nhiều và thiếu tiết chế. Khác HD_Chi_lãng_phí ở chỗ không cần khẳng định từng khoản chi đều không đem lại giá trị.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chi_quá_sức">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chi tiêu vượt mức thu nhập hoặc nguồn tiền có thể đáp ứng, dù khoản chi chưa chắc là vô ích.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chia_rẽ">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tác động khiến hai bên nghi kỵ, đối đầu hoặc xa nhau hơn, thường bằng cách kích động giữa các bên.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chia_sẻ_tận_tình">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sẵn lòng chia cả phần mình đang cần hoặc phần rất ít còn lại cho người khác. Không mặc định chỉ làm vậy với người thân.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Chịu_đựng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiếp nhận và gánh một hoàn cảnh đau khổ, khó khăn hoặc khó chấp nhận mà chưa thoát khỏi nó; không tự gán mục tiêu phục thù.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cố_chấp">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giữ khăng khăng ý kiến hoặc cách làm, không chịu nghe lời khuyên hay cân nhắc điều chỉnh.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cố_gắng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bỏ công sức để thực hiện một việc hoặc vượt trở ngại; nhãn không đảm bảo nỗ lực sẽ thành công.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Cung_cấp_thừa">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa thêm một thứ vào nơi đã có dư hoặc không cần thêm thứ ấy, khiến đóng góp trở nên không cần thiết.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Dạy_người_đã_thạo">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa chỉ dẫn cho người vốn đã biết rất rõ việc ấy, khiến lời chỉ dẫn không cần thiết. Khác việc truyền đạt kiến thức cho người chưa biết.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Dấn_thân">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bước vào hoặc tiếp tục tham gia một tình thế có rủi ro, khiến bản thân bị cuốn vào hệ quả của nó.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Dung_dưỡng_kẻ_xấu">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cho nơi ở, sự hỗ trợ hoặc quyền tiếp cận đối với người có thể phản lại và gây hại cho mình hoặc cộng đồng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đánh_tráo">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dùng một thứ để thu hút hoặc tạo kỳ vọng rồi thay bằng thứ khác không tương ứng, thường có chất lượng hay giá trị kém hơn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đáp_trả_tương_xứng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phản ứng lại việc người khác làm bằng hành động tương tự hoặc tương xứng, thường mang sắc thái trả đũa trong ngữ cảnh xung đột.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Điều_chỉnh_theo_nguồn_lực">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sắp xếp kế hoạch hay mức chi cho phù hợp với điều kiện thực có. Không nhất thiết giảm chi nếu khả năng hiện tại đã đủ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đòi_hỏi_quá_mức">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yêu cầu thêm lợi ích hoặc sự nhượng bộ vượt mức hợp lý, nhất là sau khi đã được đáp ứng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đối_đầu">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trực tiếp chống lại hoặc tranh đấu với một bên khác, không tự quy định bên nào mạnh hơn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đổi_lập_trường">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thay đổi thái độ, ý kiến hoặc phía mình ủng hộ; động cơ cơ hội chỉ được ghi khi có căn cứ riêng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đồng_hành">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ở bên và chia sẻ những trải nghiệm thuận lợi lẫn khó khăn với người khác qua thời gian.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đốt_giai_đoạn">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vội thực hiện bước cao hoặc việc khó khi chưa đạt kỹ năng và điều kiện nền tảng. Khác chỉ bắt đầu sớm hơn thời điểm đã định.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Đưa_bằng_chứng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nêu dữ kiện, dẫn chứng hoặc nguồn có thể kiểm tra để làm căn cứ cho một khẳng định.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Gán_tội">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đẩy lỗi hoặc trách nhiệm làm sai sang một người không phải người gây ra, khiến họ có nguy cơ chịu hậu quả thay.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Gây_trở_ngại">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can thiệp hoặc tạo điều kiện bất lợi khiến công việc đang diễn ra bị vướng mắc, khó tiến triển bình thường.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Giả_thương_cảm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thể hiện buồn thương hoặc cảm thông không chân thành. Không tự thêm mục đích trục lợi, xin tha hay gây thiện cảm nếu chưa có căn cứ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Giả_tử_tế">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thể hiện sự hiền lành, đạo đức hoặc thương cảm không tương ứng với bản chất hay cảm xúc thật.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Giả_vờ_không_biết">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tỏ ra không biết, không nghe hoặc không hiểu trong khi thực tế có biết hoặc có hiểu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Giữ_kín">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không nói ra, không công bố hoặc ngăn người khác tiếp cận thông tin; mục đích cụ thể chỉ gán thêm khi đã rõ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Gợi_ý_gián_tiếp">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa dấu hiệu hoặc nói bóng gió để người nghe tự nhận ra ý, thay vì diễn đạt trực tiếp toàn bộ điều muốn nói.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Hồi_phục">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dần trở lại tình trạng ổn định hơn sau giai đoạn nguy kịch hoặc gần sụp đổ; mức hồi phục cụ thể do giải nghĩa xác định.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Hợp_tác">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhiều người phối hợp công sức, ý chí hoặc sự hỗ trợ để cùng thực hiện một việc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Hùa_theo">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đi theo ý kiến, hành động hoặc xu hướng của người khác mà không thể hiện sự cân nhắc độc lập đầy đủ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Hưởng_không_đóng_góp">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhận lợi ích mà không bỏ công hoặc nguồn lực tương xứng. Không nhất thiết là trộm cắp hoặc lừa đảo.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Kết_hợp_việc">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thực hiện một cách làm chung để phục vụ đồng thời nhiều mục tiêu, thay vì xử lý từng mục tiêu bằng hành động riêng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Khiêu_khích">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cố ý chọc giận, thách thức hoặc kích phản ứng từ một đối tượng có thể đáp trả.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Không_chọn_bên">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giữ thái độ chưa đứng hẳn về lựa chọn hoặc phe nào; có thể do phân vân hoặc né cam kết.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Không_hành_động">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đứng ngoài hoặc không can thiệp trong một tình huống cần phản ứng. Không tự suy thêm rằng người đó đang chờ lợi ích tự đến.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Khuyên_bảo">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa lời chỉ dẫn, dạy bảo, giải thích hoặc phê bình với nội dung người nghe được kỳ vọng sẽ hiểu hay tiếp thu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Kiếm_tiền">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thu được tiền từ hoạt động làm ăn, công việc hoặc nguồn thu khác; số tiền lớn hay nhỏ được ghi ở KQ khi rõ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_căng_thẳng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nói hoặc làm điều làm tăng sự tức giận hay đối đầu đã có. Không tự khẳng định người làm cố ý muốn gây xung đột.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_cật_lực">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bỏ sức làm việc với cường độ cao, thời gian dài hoặc trong điều kiện rất nhọc nhằn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_chậm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Di chuyển, phản ứng hoặc thực hiện việc với tốc độ thấp; không suy ra chủ thể cố tình trì hoãn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_hòa">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giải quyết hoặc gác lại mâu thuẫn để khôi phục quan hệ thân thiện giữa các bên.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_nhanh">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Di chuyển, phản ứng hoặc thực hiện việc với tốc độ rất cao; không tự hàm ý làm ẩu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Làm_ô_danh">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Làm một người hoặc nhóm bị mang tiếng xấu. Không tự khẳng định việc ấy dùng lời nói dối hay do chủ ý ác độc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Lộng_quyền">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hành xử như thể quyền lực của mình vượt trên các quy tắc hoặc sự kiềm chế thông thường.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Lờ_đi">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cố tình không chú ý hoặc không phản ứng với điều đã biết, dù điều đó có vấn đề hoặc cần được xử lý.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Lợi_dụng_rối_ren">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khai thác sự hỗn loạn hoặc bất ổn để kiếm lợi. Phải có nét rối ren trong nghĩa đang chọn, không dùng cho mọi cơ hội thuận lợi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Lừa_dối">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dẫn người khác đến nhận thức sai hoặc không thấy sự thật bằng lời nói hay cách sắp đặt có chủ ý.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Mạo_hiểm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thực hiện việc có khả năng gây tổn thất đáng kể hoặc nguy hiểm cho bản thân; không mặc định mức liều lĩnh là đúng hay sai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Né_tránh">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rời xa hoặc tránh trực tiếp đối diện với một điều khó khăn hay bất lợi; đây là hành động, khác với MD_Né_tránh là ý định.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nghe_hời_hợt">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nghe mà không chú ý đủ hoặc không giữ lại nội dung. Khác với không có khả năng hiểu ngôn ngữ đang được nói.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Ngủ_say">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ngủ sâu và ít bị các tác động thông thường làm thức giấc. Không suy thêm về thời gian ngủ hay bệnh lý.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nịnh_nọt">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dùng lời ngọt ngào, đề cao hoặc dễ nghe hướng tới người khác, thường để tạo thiện cảm hay thuyết phục.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_dối">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phát biểu điều biết là không đúng sự thật hoặc bịa ra điều không có; khác với sai do thiếu thông tin.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_hớ">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nói ra điều thiếu cân nhắc hoặc không phù hợp, có thể khiến bản thân hay người nghe gặp rắc rối.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_làm_bất_nhất">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hành động thực tế không phù hợp hoặc trái với điều chủ thể nói hay hứa. Khác HD_Nói_suông: có thể đã hành động nhưng theo hướng ngược lời nói.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_nhiều">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nói liên tục hoặc với lượng lời lớn; chỉ riêng nhãn này không quy định lời nói đúng, sai, khoe khoang hay vô ích.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_suông">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa ra lời hứa hoặc lời nói có vẻ đáng kể nhưng thiếu hành động thực chất tương ứng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_thẳng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diễn đạt ý kiến hoặc sự thật trực tiếp, không vòng vo hay làm nhẹ lời đến mức mất nội dung.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Nói_vòng_vo">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nói quanh chủ đề hoặc kéo dài mà chưa đi thẳng vào điểm chính cần đề cập.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Phản_bội">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quay lại chống người hoặc phía từng được mình trung thành, hay ngầm làm hại người tin cậy mình. Không đồng nhất với chỉ rời khỏi một quan hệ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Phản_kháng">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chống lại sự dồn ép hoặc đối xử bất lợi sau khi đã phải chịu đựng; hình thức phản kháng không mặc định là bạo lực.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Phóng_đại">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diễn tả mức độ, quy mô hoặc tính chất lớn hơn thực tế; không mặc định mọi phóng đại đều nhằm lừa gạt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Phỏng_đoán">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa ra một hoặc nhiều khả năng giải thích khi chưa có đủ dữ liệu chắc chắn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Quyết_chiến">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đấu tranh hoặc nỗ lực đến cùng, không dễ nhượng bộ, khi việc thắng thua được xem là rất quan trọng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_So_sánh_thiên_lệch">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đánh giá lựa chọn khác có vẻ tốt hơn điều mình đang có mà chưa cân nhắc đầy đủ các mặt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Soi_lỗi">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tìm rất kỹ các khuyết điểm hoặc lỗi nhỏ ở người hay sự vật, thường để bắt bẻ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Suy_nghĩ">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Huy động trí nhớ, lập luận hoặc sự tập trung để tìm câu trả lời, đặc biệt khi việc ấy đòi hỏi nỗ lực trí óc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Tái_kết_nối_tình_cảm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nối lại tình cảm yêu đương từng có. Khác với bắt đầu yêu một người mới hoặc chỉ làm hòa sau tranh cãi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Theo_hai_phía">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Duy trì sự theo đuổi, liên hệ hoặc cam kết với hai lựa chọn hay hai bên có thể không tương thích.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Thoát_hiểm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ra khỏi một tình trạng đe dọa hoặc giai đoạn rất khó khăn; mức an toàn sau đó được thể hiện ở KQ nếu câu có nêu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Tiếp_nhận_dè_dặt">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiếp nhận thông tin nhưng chưa tin hoàn toàn, vẫn giữ sự nghi ngờ. Không tự khẳng định thông tin ấy là sai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Tìm_kiếm">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bỏ công để xác định vị trí hoặc nhận ra đối tượng cần tìm trong một phạm vi hay tập hợp.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Trả_tiền_ngay">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thanh toán ngay trong giao dịch thay vì nhận nợ hoặc để trả sau. Không đồng nhất với chi tiêu nhiều hay lãng phí.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Trao_điều_có_giá_trị">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đưa đến người khác lời hay, sự tinh tế hoặc điều hữu ích để họ tiếp nhận. Không tự suy rằng người nhận có khả năng trân trọng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Trao_đổi">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Các bên nói hoặc truyền đạt thông tin cho nhau; chất lượng hiểu nhau được xác định bằng nhãn khác.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Trì_hoãn">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đẩy việc phải làm sang thời điểm muộn hơn, đặc biệt đến sát hạn; khác với làm chậm do tốc độ thấp.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Truyền_tin">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chuyển nội dung từ người này sang người khác hoặc qua nhiều bước; không mặc định nội dung còn nguyên vẹn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Tự_gây_hại">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hành động của chính chủ thể tạo bất lợi cho họ, dù họ không nhất thiết muốn tự làm hại mình.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Tự_lo_phần_mình">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ưu tiên tự bảo đảm lợi ích của mình trong tình thế thiếu sự hỗ trợ chung. Không tự suy rằng chủ thể chủ động hại người khác.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HD_Xem_qua_loa">
  <rdf:type rdf:resource="#Hành_động"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chỉ tiếp xúc hoặc xem xét sơ lược, chưa đi sâu vào các chi tiết và bản chất cần hiểu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Bắt_lỗi">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn tìm được chỗ sai để chê trách hoặc bắt bẻ; chỉ dùng khi mục tiêu phê phán là một phần rõ ràng của nghĩa.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Cản_trở">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn làm người khác khó thực hiện, chậm tiến hành hoặc không hoàn thành công việc và kế hoạch của họ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Che_giấu_sự_thật">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn người khác không nhận ra tình hình thật, thường để tránh bất lợi hoặc duy trì sự lừa dối.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Chứng_minh">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn người nghe tin hoặc chấp nhận một khẳng định dựa trên chứng cứ có thể kiểm tra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Đổ_lỗi">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn chuyển trách nhiệm hoặc hậu quả của lỗi sang người khác thay vì đúng người gây ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Giành_thắng_lợi">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn thắng cuộc hoặc đạt thành công quyết định trước thử thách hay đối thủ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Giữ_lợi_thế">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn duy trì vị trí có lợi, phần hưởng hoặc sự thuận lợi mình đang nắm giữ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Hãm_hại">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn gây thiệt hại cho người khác về an toàn, quyền lợi hoặc danh tiếng; không gán chỉ vì hành động vô tình gây hại.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Hưởng_lợi_hai_phía">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn nhận lợi ích từ cả hai lựa chọn hoặc hai bên, dù chúng có thể cạnh tranh hay mâu thuẫn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Kiểm_soát">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn duy trì hoặc gia tăng quyền chi phối hành vi của người khác hay tình hình chung.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Lấy_lòng">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn người khác có thiện cảm, đồng ý hoặc dành ưu ái cho mình thông qua cách tiếp cận dễ nghe.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Lợi_lớn_hơn">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn thu được thứ có giá trị lớn hơn điều đã bỏ ra. Không đảm bảo ý định đó sẽ thành công.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Lừa_người_mua">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn người mua tin vào một đề nghị hoặc chất lượng không đúng với thứ thực sự cung cấp.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Né_tránh">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn tránh phải đối diện, trả lời hoặc xử lý trực tiếp một vấn đề; khác với hành động né tránh đã thực hiện.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Thoát_nguy">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn rời khỏi tình trạng nguy hiểm hoặc khó khăn đang gặp; không mặc định việc thoát đã thành công.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Tiết_kiệm">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn giảm hao tốn và giữ lại tiền hoặc nguồn lực để đáp ứng nhu cầu hay dự phòng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Tìm_lời_giải">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn nhớ ra, hiểu được hoặc giải quyết một câu hỏi hay vấn đề chưa có câu trả lời.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Tìm_ra">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn xác định được đối tượng đang tìm, chưa nói đến việc đã tìm thấy hay chưa.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Trục_lợi">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn kiếm lợi riêng bằng cách khai thác hoàn cảnh hoặc người khác, thường mang sắc thái cơ hội hay thiếu công bằng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Vừa_sức">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn mức chi hoặc kế hoạch phù hợp với nguồn lực thực có. Không mặc định muốn giảm mọi chi tiêu xuống thấp nhất.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MD_Xoay_xở">
  <rdf:type rdf:resource="#Mục_đích"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể muốn giải quyết nhu cầu trước mắt bằng cách điều chuyển nguồn lực đang thiếu, không nhất thiết xử lý được nguyên nhân gốc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bấp_bênh">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tình trạng thiếu ổn định, có thể thất bại hoặc gặp tai họa chỉ bởi một thay đổi nhỏ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bất_hòa">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quan hệ không còn hòa thuận, có mâu thuẫn hoặc đối kháng; mức độ có thể từ khó chịu đến xung đột gay gắt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bất_lợi_cho_mình">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể chịu hoặc đứng trước hậu quả xấu do lời nói, quyết định hay hành động của chính mình.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bị_đe_dọa">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An toàn, quyền lợi hoặc sự tồn tại đang đứng trước khả năng bị tổn hại; nhãn chỉ nguy cơ, không khẳng định tổn hại đã xảy ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bị_hạn_chế">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phạm vi hành động bị thu hẹp đến mức không thể làm điều muốn làm; không suy ra chủ thể thiếu năng lực.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Bị_kẹp_hai_phía">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chịu tác động hoặc sự khống chế đồng thời của hai lực gây sức ép. Không nhất thiết đang chủ động chọn giữa hai phương án.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Buồn_bã">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái buồn, ủ rũ hoặc mất tinh thần được câu mô tả; không suy ra một nguyên nhân cụ thể nếu chưa được nêu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Can_đảm">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có sự gan dạ trước thử thách hay nguy hiểm. Không đồng nhất với chỉ giữ vẻ mặt bình tĩnh hoặc không có phản ứng sinh lý vì sợ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Chen_chúc">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Người hoặc vật ở quá sát nhau trong không gian hạn chế. Không tự suy số lượng tuyệt đối lớn nếu diện tích vốn rất nhỏ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Chỉ_đủ_trước_mắt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nguồn sống chỉ đủ cho nhu cầu thiết yếu hiện tại, ít hoặc không có phần dự trữ. Không khẳng định chắc chắn đang thiếu ăn mỗi ngày.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Có_thế_lực">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có địa vị, danh tiếng hoặc ảnh hưởng đủ lớn khiến người khác phải coi trọng hoặc bị tác động.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Dễ_bị_hại">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ở vị trí phơi bày trước nguy cơ mà khó tự vệ hoặc chống đỡ. Chưa khẳng định tổn hại thực sự đã xảy ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Đau_khổ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái đau buồn hoặc tổn thương tinh thần sâu sắc; trong bộ này không dùng thay cho đau thể chất.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Đầu_mạnh_cuối_yếu">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quá trình có khởi đầu nổi bật, mạnh mẽ nhưng kết thúc yếu hoặc nhỏ bé hơn hẳn. Không mặc định hoàn toàn thất bại.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Đồng_điệu">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hai người dễ hiểu và hòa hợp với suy nghĩ, cảm nhận của nhau; khác việc chỉ đồng ý về một quyết định cụ thể.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Đúng_nhu_cầu">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều nhận được phù hợp với yêu cầu thực tế ở đúng hoàn cảnh đang cần, không nhất thiết là một mong ước lâu dài.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Được_ưu_đãi">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể có sẵn điều kiện vật chất hoặc vị thế thuận lợi từ nền tảng xuất thân, thay vì tự đạt được trong việc đang xét.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Gánh_lỗi_thay">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Một người bị đặt vào vị trí chịu trách nhiệm hoặc hậu quả cho việc sai không do mình gây ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Gắn_bó">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quan hệ thân thiết, bền chặt hoặc có sự hiện diện hỗ trợ thường xuyên; không nhất thiết là quan hệ yêu đương.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Gây_phiền_toái">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lời nói hoặc hành vi tạo ra sự khó xử, ngượng ngùng hay rắc rối. Không tự nâng lên mức tai họa nghiêm trọng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Giàu_có">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sở hữu nhiều tiền của hoặc tài sản; không tự khẳng định sự giàu có đến từ nỗ lực hay may mắn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Giận_dữ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái tức giận mạnh; chỉ gán HD_Bùng_giận thêm khi câu nhấn mạnh quá trình bùng phát cơn giận.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Giống_bản_chất">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhiều người có cùng kiểu tính cách hoặc đặc điểm bên trong. Không gộp với giống ngoại hình hay chỉ tương hợp trong một quan hệ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hết_nhẫn_nhịn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể không tiếp tục chịu đựng một cách phục tùng như trước. Trong các dòng dùng nhãn này, hành động phản kháng được ghi riêng ở HD.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hiển_nhiên">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thông tin hoặc tình trạng rõ đến mức dễ nhận thấy, ít cần suy đoán để hiểu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hiểu_rõ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có kiến thức hoặc sự quen thuộc rất sâu đối với nơi chốn, đối tượng hay vấn đề đang nói tới.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hòa_hợp_trở_lại">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quan hệ được khôi phục sự thân thiện hoặc gắn bó sau giai đoạn bất hòa hay chia cách.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hoài_nghi">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chưa tin hoàn toàn và vẫn nghi ngờ điều đang xét. Không đồng nhất với kết luận chắc chắn điều đó sai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hời_hợt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức tiếp cận mới dừng ở bề mặt, chưa đạt độ hiểu sâu cần thiết; không tự khẳng định toàn bộ nhận định là sai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hợp_môi_trường">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Môi trường phù hợp với sở trường hoặc thói quen, khiến chủ thể thấy tự nhiên và thoải mái. Không đảm bảo thành công cụ thể.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Hứng_chịu_công_kích">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đứng ở vị trí trực tiếp chịu nguy hiểm hoặc sự chỉ trích. Không tự gán trách nhiệm lãnh đạo.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Khó_khăn_tiếp_diễn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sau khi thoát một trở ngại, chủ thể lại gặp trở ngại khác; không mặc định mọi trường hợp trở ngại mới đều nặng hơn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Khó_rút_lui">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Việc đã tham gia hoặc cam kết khiến dừng lại, thoát ra hay đảo hướng trở nên khó khăn hoặc nguy hiểm.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Khó_thành_công">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khả năng đạt mục tiêu rất thấp hoặc bị nhiều trở ngại chi phối; đây là triển vọng, không phải kết luận đã thất bại.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_đáng_kể">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức đóng góp hoặc tác động quá nhỏ khi so với quy mô nhu cầu hay tổng thể cần giải quyết.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_đạt_cả_hai">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không đạt được phương án nào trong hai khả năng đang xét. Không tự thêm động cơ tham lam muốn chiếm cả hai.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_được_trân_trọng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều có giá trị không được người nhận hiểu, thưởng thức hoặc coi trọng. Không đồng nhất với hiểu rõ nhưng không nghe theo chỉ dẫn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_ghi_nhớ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nội dung nghe được không được giữ lại hay không được để tâm. Khác với hiểu mà nhất định không làm theo lời khuyên.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_hiểu">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không nắm được ý nghĩa của thông tin hoặc lời nói đang tiếp nhận; khác với hiểu nhưng không muốn nghe theo.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_thể_đảo_ngược">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tình thế đã đi quá xa để có thể trở lại trạng thái trước; mạnh hơn việc chỉ khó rút lui.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_thỏa_mãn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể không bằng lòng với điều đang có hoặc vẫn cho rằng điều khác đáng muốn hơn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_thu_được_gì">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể không có thành quả, tài sản hoặc lợi ích mong muốn để nhận sau quá trình đã diễn ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_tiếp_thu">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lời nói, khuyên bảo hay phê bình không tạo được sự đón nhận hoặc thay đổi tương ứng ở người nghe; không đồng nhất với không hiểu ngôn ngữ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Không_tiết_lộ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thông tin chưa được nói ra hoặc chưa trở thành điều người ngoài biết; không nhất thiết có động cơ xấu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lãng_phí">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiền, thời gian hoặc công sức đã bỏ ra không mang lại giá trị tương xứng hoặc bị mất đi vô ích.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lạnh_nhạt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thái độ thiếu thân thiện, ít biểu lộ tình cảm hoặc tạo khoảng cách. Không tự khẳng định người đó độc ác hoặc hoàn toàn thiếu lòng trắc ẩn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lệch_ý">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Các bên giao tiếp không hiểu nhau vì đang nghĩ về vấn đề theo những hướng hoặc nghĩa khác nhau.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lo_lắng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái bất an, sốt ruột hoặc hồi hộp về điều chưa chắc chắn hay có nguy cơ bất lợi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lộ_bản_chất">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đặc điểm thật hay ý đồ từng được che giấu trở nên có thể nhận ra, thường là mặt xấu trong các dòng sử dụng nhãn này.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lợi_ích_kép">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Một hành động đem lại hai mục tiêu hay lợi ích khác nhau; không nhất thiết là lợi nhuận tài chính.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Lưỡng_nan">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể ở giữa những lựa chọn hoặc sức ép đối lập, khó chọn một hướng mà không chịu bất lợi hoặc từ bỏ điều quan trọng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Mạnh_bề_ngoài">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bề ngoài có vẻ mạnh hoặc đáng sợ nhưng thực lực không tương xứng. Không đồng nhất với mạnh thật mà chủ động kiềm chế.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nắm_lợi_thế">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể đang giữ điều kiện quyết định hoặc ưu thế cho phép chi phối diễn biến theo hướng có lợi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Ngang_mức">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hai đối tượng gần ngang nhau về thuộc tính đang so sánh, có thể là năng lực, chất lượng hoặc mức độ. Không chỉ áp dụng cho sức mạnh hay cuộc đua.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nghèo_khó">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thiếu tiền của hoặc điều kiện vật chất để sống thoải mái; không quy kết nguyên nhân nghèo.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nghiêm_trọng_hóa">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Một việc bị nhìn hoặc trình bày như nghiêm trọng hơn thực tế; đây có thể là hệ quả diễn ngôn, không phải vấn đề thật đã lớn lên.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nguy_cơ_phản_bội">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có khả năng người được hỗ trợ hoặc tin cậy quay lại gây hại; không khẳng định sự phản bội đã thực sự xảy ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nhút_nhát">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đặc điểm dễ sợ hoặc thiếu mạnh dạn được câu mô tả như một trạng thái tính cách, không phải hệ quả của một hành động ngầm định.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Nợ_nần">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có nghĩa vụ trả một lượng tiền đáng kể, thường vượt mức dễ dàng thanh toán trong ngữ nghĩa đang xét.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Phản_tác_dụng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phương án nhằm tác động xấu lên người khác lại gây bất lợi cho chính người đề ra hoặc thực hiện.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Qua_nguy_hiểm">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể đã vượt giai đoạn nguy kịch hoặc phần khó khăn nhất; không đảm bảo mọi rủi ro về sau đều biến mất.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Quá_tải">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lượng việc, trách nhiệm hoặc đòi hỏi vượt mức có thể xử lý thoải mái, làm chủ thể thiếu thời gian hoặc kiệt sức.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Rất_giống_nhau">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hai đối tượng có mức tương đồng rất cao ở đặc điểm đang so sánh; không tự mở rộng sang mọi đặc điểm khác.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Rất_khác_nhau">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hai đối tượng có khoảng cách rất lớn về đặc điểm, hoàn cảnh hoặc chất lượng đang được xét.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Rất_khỏe">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có sức lực thể chất lớn. Không quy đổi thành can đảm, thông minh hay quyền lực xã hội.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Rùng_mình">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phản ứng cơ thể như nổi da gà do sợ, kinh ngạc hoặc xúc động mạnh; không mặc định cảm xúc là tiêu cực.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sai_lệch_thông_tin">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nội dung bị biến dạng, gán sai hoặc hiểu sai so với điều ban đầu cần truyền đạt; có thể xảy ra không có chủ ý.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sai_sự_thật">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nội dung được phát biểu không phù hợp với thực tế; nhãn này đi cùng HD_Nói_dối khi sự sai lệch là cố ý.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sát_hạn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Việc hành động bị đẩy đến thời điểm gần hết khoảng thời gian có thể xử lý một cách thuận lợi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sống_còn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tình thế được đặt ở mức phải thành công hoặc chịu thất bại toàn diện. Không mặc định chủ thể thực tế sẽ chết nếu thua.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sợ_hãi">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái lo sợ mạnh trước điều đe dọa hoặc đáng kinh hãi, không nhất thiết là đặc điểm tính cách lâu dài.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sung_túc">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sống trong điều kiện dư dả, có đủ phương tiện để hưởng sự thoải mái; không tự xác định nguyên nhân do may hay do làm việc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Sững_sờ">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bị bất ngờ đến mức tạm thời khó phản ứng hoặc tiếp nhận điều vừa xảy ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Tách_rời">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Các bên không còn tiếp tục chung đường hoặc gắn với nhau trong quan hệ, dự án hay tình thế đang xét.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Tai_họa_dồn_dập">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhiều điều xấu đến cùng lúc hoặc nối tiếp nhau, thay vì một bất lợi đơn lẻ. Không quy định phải liên quan tiền hay sức khỏe.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Tái_nhợt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sắc mặt trở nên rất nhợt, trong nghĩa đang chọn là phản ứng trước sợ hãi hoặc sốc; không gán chẩn đoán y khoa.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thiếu_hụt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nguồn tiền hoặc vật chất không đủ để đáp ứng đồng thời các nhu cầu, có thể chỉ đủ cho sinh hoạt trước mắt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thoát_trong_gang_tấc">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đã tránh được nguy hiểm nhưng chỉ nhờ một khoảng cách, thời gian hoặc cơ hội rất nhỏ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thu_nhập_lớn">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiền được thu về với lượng lớn hoặc tốc độ cao; khác KQ_Giàu_có là mức tài sản đã sở hữu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thua_lỗ_nặng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mất một phần rất lớn hoặc toàn bộ số tiền, vốn hay tài sản đã có hoặc đem vào rủi ro.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thuận_lợi">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quá trình thực hiện tiến triển dễ dàng với ít trở ngại đáng kể; không mặc định kết quả cuối cùng đã đạt.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Thừa_thãi">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều được cung cấp hoặc chỉ dẫn không cần thiết vì người nhận hay tình huống đã đáp ứng nhu cầu đó.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Tiến_triển_tốt">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Công việc hoặc vị thế đang phát triển theo chiều tích cực. Không tự gán nguyên nhân là may mắn hay đảm bảo đã giàu có.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Toại_nguyện">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều thực tế nhận được phù hợp với điều chủ thể đã mong muốn từ trước.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Ướt_sũng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Người hoặc quần áo bị ướt rất nhiều, thường trông nhếch nhác. Không tự suy nguyên nhân là mưa, ngã xuống nước hay bơi.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Vô_cảm">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thiếu thương xót hoặc không bị lay động trước đau khổ, cảm xúc hay lời cầu xin của người khác.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Vô_ích">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Việc làm hoặc công sức không tạo ra tiến bộ hay kết quả hữu ích; khác lãng phí ở chỗ không bắt buộc nhấn mạnh phần nguồn lực bị mất.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Vui_sướng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trạng thái hạnh phúc, phấn khởi hoặc thỏa mãn ở mức rất cao.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Vượt_khả_năng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức chi hoặc yêu cầu vượt giới hạn nguồn lực có thể đáp ứng; trong bộ hiện tại tập trung vào chi tiêu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KQ_Xung_đột_tăng">
  <rdf:type rdf:resource="#Kết_quả"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức căng thẳng, thù địch hoặc đối đầu giữa các bên trở nên mạnh hơn trước.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Cảm_xúc">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trải nghiệm hoặc biểu hiện tình cảm của chủ thể như vui, buồn, sợ, giận; không mặc định nguyên nhân nếu câu không nêu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Công_việc">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Một nhiệm vụ, kế hoạch hoặc quá trình thực hiện việc cần làm; không giới hạn ở việc làm có trả lương.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Đánh_giá">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hoạt động nhận xét chất lượng, động cơ, ưu điểm hoặc khuyết điểm của người hay sự việc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Đời_sống">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều kiện sinh hoạt và mức hưởng thụ trong cuộc sống thường ngày; không tự quy định nguồn gốc của điều kiện ấy.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Giao_tiếp">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tình huống nói, nghe hoặc trao đổi giữa người với người; nhãn không hàm ý đã giao tiếp thành công.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Không_gian">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không gian được xét về mức chật, rộng, đông hoặc vắng. Không suy từ chật chội sang tình trạng nghèo khó hay nguy hiểm.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Lợi_ích">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Việc tìm kiếm, bảo vệ hoặc phân chia phần có lợi cho cá nhân hay nhóm; không tự khẳng định hành vi là xấu.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_May_rủi">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yếu tố ngẫu nhiên hoặc điều ngoài khả năng kiểm soát ảnh hưởng đến triển vọng hay kết quả của chủ thể.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Mua_bán">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quan hệ cung cấp, chào hàng, mua hàng hoặc trao đổi giá trị giữa bên bán và bên mua.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Năng_lực">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khả năng thực hiện một việc, mức chuẩn bị hoặc độ phù hợp giữa kỹ năng của chủ thể với hoạt động và môi trường.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Nghịch_cảnh">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hoàn cảnh đau khổ, bất lợi hoặc khó khăn mà chủ thể phải chịu hay cố gắng vượt qua.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Ngoại_hình">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dáng vẻ hoặc tình trạng nhìn thấy ở người, quần áo và đồ vật. Không dùng ngoại hình để suy đoán tính cách hay năng lực.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Nguồn_lực">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tiền của, thời gian, công sức hoặc phương tiện được xem xét về mức đủ, thiếu, sử dụng hay lãng phí.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Nguy_hiểm">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có khả năng tổn hại đáng kể đối với con người, công việc hoặc lợi ích; không mặc định tai họa đã xảy ra.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Nhận_thức">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phạm vi hiểu biết, mức hiểu vấn đề hoặc cách nhìn thế giới của chủ thể.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Quan_hệ">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mối liên hệ giữa người với người, gồm tình bạn, gia đình, đồng nghiệp hoặc các quan hệ hỗ trợ và tin cậy.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Quyền_lực">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khả năng ảnh hưởng, kiểm soát, quyết định hoặc buộc người khác phải tuân theo trong một tổ chức hay cộng đồng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Quyết_định">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể cân nhắc, lựa chọn hoặc đã định đoạt một hướng hành động, nhất là khi có hệ quả đáng kể.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Rủi_ro">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chủ thể đứng trước khả năng được hoặc mất đáng kể khi tham gia một việc có kết quả không chắc chắn.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_So_sánh">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đặt hai người hoặc sự vật cạnh nhau để xét mức giống, khác hay tương xứng của họ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Sức_khỏe">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sức lực và tình trạng cơ thể; trong bản này dùng để xét mức khỏe về thể chất, không đưa ra chẩn đoán.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Tài_chính">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thu nhập, tiền bạc, chi tiêu, tài sản hoặc nợ; ưu tiên nhãn này khi nghĩa đang chọn chỉ rõ yếu tố tiền.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Tập_thể">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nhiều người cùng hành động hoặc có quan hệ về lập trường và mục tiêu trong một nhóm.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Thông_tin">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sự tồn tại, độ đúng, việc truyền đi, che giấu hoặc tiếp nhận tin tức và tri thức.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Tính_cách">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Đặc điểm tương đối ổn định trong cách một người cảm nhận hoặc hành xử; không đồng nhất với cảm xúc nhất thời.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Tốc_độ">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức nhanh hoặc chậm của chuyển động, phản ứng hay tiến độ thực hiện một việc.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Ứng_xử">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cách một người thể hiện thái độ, xử sự hoặc trình bày bản thân trước người khác.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BC_Xung_đột">
  <rdf:type rdf:resource="#Bối_cảnh"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Có sự đối kháng, tranh chấp, tức giận hoặc hành vi gây hại giữa các bên.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung1">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
  <Có_hành_động rdf:resource="#HD_Nói_thẳng"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Nói_toạc_móng_heo">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung1"/>
  <rdfs:comment xml:lang="vi">Nói thẳng sự thật, không né tránh cách gọi có thể khó nghe.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Call_a_spade_a_spade">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung1"/>
  <rdfs:comment xml:lang="en">To describe something frankly, using direct words even when they may offend.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Thẳng_như_ruột_ngựa">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung1"/>
  <rdfs:comment xml:lang="vi">Thẳng thắn, nói đúng điều mình nghĩ.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Not_mince_ones_words">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung1"/>
  <rdfs:comment xml:lang="en">To express an opinion plainly without softening its potentially unpleasant meaning.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung2">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
  <Có_hành_động rdf:resource="#HD_Nói_vòng_vo"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Vòng_vo_tam_quốc">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung2"/>
  <rdfs:comment xml:lang="vi">Nói quanh co, kéo dài mà tránh đi vào vấn đề chính.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Beat_around_the_bush">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung2"/>
  <rdfs:comment xml:lang="en">To talk around an issue instead of addressing its central point directly.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung3">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
  <Có_hành_động rdf:resource="#HD_Đưa_bằng_chứng"/>
  <Có_mục_đích rdf:resource="#MD_Chứng_minh"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Nói_có_sách_mách_có_chứng">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung3"/>
  <rdfs:comment xml:lang="vi">Nói hoặc khẳng định điều gì kèm căn cứ rõ ràng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Give_chapter_and_verse">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung3"/>
  <rdfs:comment xml:lang="en">To support an account or claim with precise details and authoritative evidence.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung4">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
  <Có_hành_động rdf:resource="#HD_Nói_suông"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khua_môi_múa_mép">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung4"/>
  <rdfs:comment xml:lang="vi">Nói nhiều, nói hay nhưng thiếu hành động thực chất tương ứng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#All_talk_and_no_action">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung4"/>
  <rdfs:comment xml:lang="en">To make impressive claims or promises without backing them up with action.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung5">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
  <Có_hành_động rdf:resource="#HD_Nói_nhiều"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Nói_như_khướu">
  <rdf:type rdf:resource="#Vietnamese_idiom"/>
  <Có_khung rdf:resource="#Khung5"/>
  <rdfs:comment xml:lang="vi">Nói rất nhiều, liên tục, khó dừng.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Talk_the_hind_legs_off_a_donkey">
  <rdf:type rdf:resource="#English_Idiom"/>
  <Có_khung rdf:resource="#Khung5"/>
  <rdfs:comment xml:lang="en">To talk at great length and seemingly without stopping.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Khung6">
  <rdf:type rdf:resource="#Khung_Bản_Thể_học"/>
  <Có_bối_cảnh rdf:resource="#BC_Giao_tiếp"/>
